# Torre — variables de entorno. Copia este archivo como `.env` y llena lo tuyo.
#
# OJO CON EL FORMATO: el loader es literal — KEY=VALUE por línea, sin comillas
# y SIN comentarios en la misma línea del valor (todo tras el `=` ES el valor).
# Comentarios solo en líneas propias, como estas. Las variables ya exportadas
# en el ambiente GANAN sobre este archivo.

# ── Núcleo ────────────────────────────────────────────────────────────────────
# TORRE_SECRET_KEY: OBLIGATORIA en producción (con TORRE_HTTPS=1 no arranca sin ella).
# TORRE_DEBUG: 0 en producción.
# TORRE_HTTPS: 1 en producción tras Caddy (cookies secure + HSTS + fail-fast);
#   0 mientras se sirva por http (modo IP/staging) o el login no funciona.
# BASE_URL_PUBLICA: dominio público real — alimenta links de rastreo y QRs.
TORRE_SECRET_KEY=
TORRE_DEBUG=1
TORRE_ALLOWED_HOSTS=localhost,127.0.0.1
TORRE_HTTPS=0
BASE_URL_PUBLICA=http://127.0.0.1:8380

# ── Base de datos ─────────────────────────────────────────────────────────────
# TORRE_DB: postgres | sqlite | vacío (=SQLite, solo dev rápido). Typo = no arranca.
TORRE_DB=postgres
PGDATABASE=torre
PGUSER=torre
PGPASSWORD=torre
PGHOST=localhost
PGPORT=5432

# ── Negocio ───────────────────────────────────────────────────────────────────
# Corte contractual — confirmar 15:30 (adéndum) con el founder.
TORRE_CORTE=14:00

# ── Envia.com (carriers) ──────────────────────────────────────────────────────
# ENVIA_MODO: off | cotizar | full — SOLO full COMPRA guías reales (dinero).
ENVIA_API_KEY=
ENVIA_MODO=cotizar

# ── Impresión de etiquetas ────────────────────────────────────────────────────
# TORRE_MODO_IMPRESION: local (lp/CUPS en el server) | relay (agente en bodega).
# TORRE_IMPRESORA_ETIQUETAS: nombre de la cola CUPS (modo local).
# TORRE_TOKEN_IMPRESION: token Bearer del agente relay (vacío = API cerrada, 403).
TORRE_MODO_IMPRESION=local
TORRE_IMPRESORA_ETIQUETAS=
TORRE_TOKEN_IMPRESION=

# ── WhatsApp Cloud API (vacío = los mensajes salen a consola) ─────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Web Push VAPID (vacío = push apagado en silencio) ─────────────────────────
# VAPID_PRIVATE_PEM es la RUTA al .pem (gitignored: *.pem), relativa al repo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_PEM=vapid_private.pem
VAPID_CLAIM_EMAIL=

# ── Spaces / S3 para fotos de evidencia (vacío = disco local, solo dev) ───────
# Llave de acceso POR BUCKET (panel DO → bucket → Access Keys → Create).
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=torre-evidencia
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
