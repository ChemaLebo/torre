# Torre — variables de entorno. Copia este archivo como `.env` y llena lo tuyo.
# El loader es simple (KEY=VALUE por línea, sin comillas); las variables ya
# exportadas en el ambiente GANAN sobre este archivo.

# ── Núcleo ────────────────────────────────────────────────────────────────────
TORRE_SECRET_KEY=                 # OBLIGATORIA en producción (con TORRE_HTTPS=1 el server no arranca sin ella)
TORRE_DEBUG=1                     # 0 en producción
TORRE_ALLOWED_HOSTS=localhost,127.0.0.1
TORRE_HTTPS=0                     # 1 en producción tras Caddy: cookies secure + HSTS + fail-fast
BASE_URL_PUBLICA=http://127.0.0.1:8380    # dominio público real en prod — alimenta links de rastreo y QRs de etiquetas

# ── Base de datos ─────────────────────────────────────────────────────────────
TORRE_DB=postgres                 # vacío/sqlite = SQLite (solo dev rápido); cualquier otro valor no arranca
PGDATABASE=torre
PGUSER=torre
PGPASSWORD=torre                  # el del docker-compose en dev; el real en prod
PGHOST=localhost
PGPORT=5432

# ── Negocio ───────────────────────────────────────────────────────────────────
TORRE_CORTE=14:00                 # corte contractual — confirmar 15:30 (adéndum) con el founder

# ── Envia.com (carriers) ──────────────────────────────────────────────────────
ENVIA_API_KEY=
ENVIA_MODO=cotizar                # off | cotizar | full — SOLO full COMPRA guías reales (dinero)

# ── Impresión de etiquetas ────────────────────────────────────────────────────
TORRE_MODO_IMPRESION=local        # local (lp/CUPS en el server) | relay (agente en bodega)
TORRE_IMPRESORA_ETIQUETAS=        # nombre de la cola CUPS (modo local)
TORRE_TOKEN_IMPRESION=            # token Bearer del agente relay (vacío = API cerrada, 403)

# ── WhatsApp Cloud API (vacío = los mensajes salen a consola) ─────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Web Push VAPID (vacío = push apagado en silencio) ─────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_PEM=vapid_private.pem   # RUTA al .pem (gitignored: *.pem), relativa a la raíz del repo
VAPID_CLAIM_EMAIL=
